generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  client
}

model User {
  id                Int               @id @default(autoincrement())
  name              String            @db.VarChar(50)
  email             String            @unique @db.VarChar(100)
  passwordHash      String            @map("password_hash")
  cpf               String            @unique @db.VarChar(11)
  phone             String?           @unique @db.VarChar(11)
  role              UserRole          @default(client)
  mpCustomerId      String?           @unique @map("mp_customer_id")
  carts             Cart[]
  shippingAddresses ShippingAddress[]
  userPaymentCards  UserPaymentCard[]

  @@map("users")
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(255)
  description   String         @db.VarChar(500)
  price         Decimal        @db.Decimal(10, 2)
  stock         Int
  productImages ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  publicId  String  @map("public_id")
  position  Int
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  @@unique([position, productId])
  @@map("product_images")
}

enum CartStatus {
  active
  finished
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  status    CartStatus
  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@id([cartId, productId])
  @@map("cart_items")
}

model ShippingAddress {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  receiverName      String  @map("receiver_name") @db.VarChar(50)
  receiverPhone     String  @map("receiver_phone") @db.VarChar(11)
  street            String  @db.VarChar(150)
  number            String  @db.VarChar(10)
  addressComplement String? @map("address_complement") @db.VarChar(100)
  city              String  @db.VarChar(50)
  state             String  @db.Char(2)
  zipCode           String  @map("zip_code") @db.VarChar(9)
  user              User    @relation(fields: [userId], references: [id])

  @@map("shipping_addresses")
}

enum StatusOrder {
  pending
  shipped
  delivered
  canceled
}

model Order {
  id                Int         @id @default(autoincrement())
  orderCode         String      @unique @map("order_code") @db.Text
  status            StatusOrder @default(pending)
  shippingAddressId Int         @map("shipping_address_id")
  userId            Int         @map("user_id")
  itemsPrice        Decimal     @db.Decimal(10, 2)
  shippingPrice     Decimal     @db.Decimal(10, 2)
  totalPrice        Decimal     @db.Decimal(10, 2)
  createdAt         DateTime    @default(now()) @map("created_at")
  orderItems        OrderItem[]
  payments          Payment[]

  @@map("orders")
}

model OrderItem {
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
  @@map("order_items")
}

model UserPaymentCard {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  holderName    String    @map("holder_name") @db.VarChar(50)
  cardToken     String    @unique @map("card_token") @db.Text
  lastDigits    String    @map("last_digits") @db.VarChar(4)
  cardBrand     String    @map("card_brand") @db.VarChar(50)
  validateMonth String    @map("validate_month") @db.VarChar(2)
  validateYear  String    @map("validate_year") @db.VarChar(4)
  user          User      @relation(fields: [userId], references: [id])
  payments      Payment[]

  @@map("user_payment_card")
}

enum PaymentMethod {
  card
  pix
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  canceled
}

enum PaymentGateway {
  stripe
}

model Payment {
  id      Int            @id @default(autoincrement())
  orderId Int            @map("order_id")
  method  PaymentMethod
  gateway PaymentGateway
  status  PaymentStatus  @default(pending)
  amount  Decimal        @db.Decimal(10, 2)

  externalId String? @unique @map("external_id") @db.Text

  userPaymentCardId Int?             @map("user_payment_card_id")
  userPaymentCard   UserPaymentCard? @relation(fields: [userPaymentCardId], references: [id])

  pixQrCode    String?   @map("pix_qr_code") @db.Text
  pixCopyPaste String?   @map("pix_copy_paste") @db.Text
  pixExpiresAt DateTime? @map("pix_expires_at")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}
